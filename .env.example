# Copy to .env.local and edit privately. Never put real credentials here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Use Supabase's secret key, never a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
APP_OWNER_USER_ID=
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR

# Enable only in an isolated environment until Phase 2 production approval.
EXPENSE_PHASE_2_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=
# Random hex, generated locally by npm run verify:setup.
TELEGRAM_WEBHOOK_SECRET=

# User-selected: Gemini Developer API, strictly free tier; no billing linked.
# This flag records application policy; it cannot control Google's billing state.
AI_PROVIDER=gemini
AI_FREE_TIER_ONLY=true
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Set a daily cap only after successful generation and verification of the selected model's Free-tier quota.
GEMINI_DAILY_REQUEST_LIMIT=0

# Used for authenticated recovery/scheduled endpoints; generated locally.
CRON_SECRET=

# Phase 3 only; leave blank for Phase 1.
AI_VISION_MODEL=
AI_TRANSCRIPTION_MODEL=
